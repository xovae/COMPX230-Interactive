@inject IJSRuntime JSRuntime
@inject ChecklistStateStore ChecklistState
@implements IDisposable

<div class="col-auto border border-primary-subtle border-start-0 border-2" @ref="levelSelectRef">
    <button class="btn btn-primary my-2" type="button" data-bs-toggle="collapse" data-bs-target="#levelSelect" aria-expanded="true" aria-controls="levelSelect">
        ☰
    </button>
    <div class="collapse collapse-horizontal show" id="levelSelect">
        <ul class="nav flex-column nav-pills">
            @* Sandbox - Home Page - position in list as needed *@
            <LevelNavItem href="." name="Sandbox" Steps="@NoSteps" />

            @* Example levels *@
            <LevelNavItem href="levelOne" name="Introduction" Steps='@GetLevelSteps("levelOne")' LevelId="levelOne" SelectedStepIndex='@GetSelectedStepIndex("levelOne")' />
            <LevelNavItem href="levelBranching" name="Branching" Steps="@NoSteps" />
            <LevelNavItem href="levelFour" name="Bitwise" Steps='@GetLevelSteps("levelFour")' LevelId="levelFour" SelectedStepIndex='@GetSelectedStepIndex("levelFour")' />
            <LevelNavItem href="levelFive" name="Memory" Steps='@GetLevelSteps("levelFive")' LevelId="levelFive" SelectedStepIndex='@GetSelectedStepIndex("levelFive")' />

            <button class="btn btn-danger float-end my-2 ms-4" @onclick="ResetLevels" data-bs-toggle="modal" data-bs-target="#deleteModal" @ref="resetLevelButtonRef">
                Reset Level Progress
            </button>
        </ul>
    </div>
</div>

@code {
    private static readonly IReadOnlyList<ChecklistStep> NoSteps = [];
    private ElementReference levelSelectRef;
    private ElementReference resetLevelButtonRef;
    [Inject]
    private SpotlightRegistry SpotlightRegistry { get; set; } = default!;


    protected override void OnInitialized()
    {
        ChecklistState.StateChanged += HandleChecklistStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            SpotlightRegistry.Register("levelSelect", levelSelectRef);
            SpotlightRegistry.Register("resetLevelButton", resetLevelButtonRef);
            await JSRuntime.InvokeVoidAsync("levelSelect");
            await JSRuntime.InvokeVoidAsync("levelCheck");
            await JSRuntime.InvokeVoidAsync("clearPopovers");
        }
    }

    private IReadOnlyList<ChecklistStep> GetLevelSteps(string levelId)
    {
        if (ChecklistState.TryGetSteps(levelId, out IReadOnlyList<ChecklistStep>? steps))
        {
            return steps;
        }

        return NoSteps;
    }

    private int GetSelectedStepIndex(string levelId)
    {
        if (ChecklistState.TryGetSelectedStepIndex(levelId, out int selectedStepIndex))
        {
            return selectedStepIndex;
        }

        return -1;
    }

    private void HandleChecklistStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ChecklistState.StateChanged -= HandleChecklistStateChanged;
    }

    public void ResetLevels()
    {
        JSRuntime.InvokeVoidAsync("resetLevels");
    }
}